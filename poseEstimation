import tensorflow as tf
import tensorflow_hub as hub
import cv2
import numpy as np

# Load the MoveNet MultiPose Lightning model
movenet = hub.load("https://tfhub.dev/google/movenet/multipose/lightning/1")

# Define keypoint connections for visualization
connections = [(0, 1), (0, 2), (1, 3), (2, 4),
               (0, 5), (0, 6), (5, 7), (7, 9), (6, 8), (8, 10),
               (5, 6), (5, 11), (6, 12), (11, 12),
               (11, 13), (13, 15), (12, 14), (14, 16)]

# Perform multiperson pose detection on a frame
def detect_pose_frame(frame):
    h, w, _ = frame.shape
    image_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

    # Resize to model's expected input
    input_size = 256
    resized_image = cv2.resize(image_rgb, (input_size, input_size))
    input_tensor = tf.expand_dims(resized_image, axis=0)
    input_tensor = tf.cast(input_tensor, dtype=tf.int32)

    # Inference
    outputs = movenet.signatures["serving_default"](input_tensor)
    keypoints_with_scores = outputs['output_0'].numpy()  # Shape: (1, 6, 56)

    return keypoints_with_scores, h, w

# Draw keypoints and skeletons for each person
def draw_keypoints(frame, keypoints_with_scores, orig_h, orig_w):
    people = keypoints_with_scores[0]

    for person in people:
        # 17 keypoints * 3 (y, x, score) = 51
        keypoints = person[:51].reshape((17, 3))
        person_score = person[55]

        if person_score < 0.2:  # skip very low confidence detections
            continue

        # Draw keypoints
        for idx, kp in enumerate(keypoints):
            y, x, confidence = kp
            if confidence > 0.2:
                x_coord = int(x * orig_w)
                y_coord = int(y * orig_h)
                cv2.circle(frame, (x_coord, y_coord), 4, (255, 0, 0), -1)

        # Draw connections
        for c in connections:
            kp1 = keypoints[c[0]]
            kp2 = keypoints[c[1]]
            if kp1[2] > 0.2 and kp2[2] > 0.2:
                x1, y1 = int(kp1[1] * orig_w), int(kp1[0] * orig_h)
                x2, y2 = int(kp2[1] * orig_w), int(kp2[0] * orig_h)
                cv2.line(frame, (x1, y1), (x2, y2), (0, 0, 255), 2)

# === Main Execution ===

video_path = "C:/Users/navee/Videos/video1.mkv"  # Replace with your video path
cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("Error: Cannot open video file.")
    exit()

cap.set(cv2.CAP_PROP_POS_MSEC, 2 * 60 * 1000)
cv2.namedWindow("MultiPose MoveNet", cv2.WINDOW_NORMAL)

frame_count = 0
cached_keypoints = None
cached_h, cached_w = None, None

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame_count += 1

    if frame_count % 5 == 0:
        # Run inference every 3rd frame
        cached_keypoints, cached_h, cached_w = detect_pose_frame(frame)

    # Draw latest keypoints if available
    if cached_keypoints is not None:
        draw_keypoints(frame, cached_keypoints, cached_h, cached_w)

    # Resize for display (1080p)
    display_frame = cv2.resize(frame, (1920, 1080))
    cv2.imshow("MultiPose MoveNet", display_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
